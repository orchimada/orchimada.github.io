<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.orchimada.habits-publish</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/orchimada/website/orchimada.github.io/tools/publish-habits.sh</string>
  </array>

  <!-- fires whenever anything in Journal/Daily is saved (Obsidian, iCloud sync) -->
  <key>WatchPaths</key>
  <array>
    <string>/Users/orchimada/Library/Mobile Documents/iCloud~md~obsidian/Documents/Orchilux/Journal/Daily</string>
  </array>

  <!-- debounce: at most one run every 60 s, whatever iCloud does -->
  <key>ThrottleInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>/tmp/habits-publish.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/habits-publish.log</string>
</dict>
</plist>
